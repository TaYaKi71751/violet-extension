{
  "manifest_version": 2,
  "name": "Violet Extension",
  "version": "0.0.1",
  "description": "Convert supported gallery URLs into violet:// deep links.",
  "icons": {
    "128": "icon.png"
  },
  "browser_action": {
    "default_title": "Open page in Violet",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "tabs",
    "https://nhentai-media-id.vercel.app/*"
  ]
}
